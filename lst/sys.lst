    44                                  %include "./src/sysMain.asm"
     1                              <1> startSys:
     2 00000000 EB03                <1>     jmp short .cVersion
     3 00000002 01                  <1> .vNum:          db 1
     4 00000003 0002                <1> .sectorSize:    dw 200h
     5                              <1> .cVersion:
     6 00000005 50                  <1>     push rax
     7 00000006 B430                <1>     mov ah, 30h
     8 00000008 CD21                <1>     int 21h
     9 0000000A 3A05F2FFFFFF        <1>     cmp al, byte [.vNum] ;Version 1
    10 00000010 760D                <1>     jbe .okVersion
    11 00000012 58                  <1>     pop rax
    12 00000013 488D1501060000      <1>     lea rdx, badVerStr
    13 0000001A E951030000          <1>     jmp badPrint ;Exit to caller or DOS to print bad command interpreter line
    14                              <1> .okVersion:
    15                              <1> ;Check the passed argument is ok (flag in al)
    16 0000001F 58                  <1>     pop rax
    17 00000020 3CFF                <1>     cmp al, -1
    18 00000022 750C                <1>     jnz .driveOk
    19                              <1> .badDrive:
    20 00000024 488D1506060000      <1>     lea rdx, badDrvLtr
    21 0000002B E940030000          <1>     jmp badPrint
    22                              <1> .driveOk:
    23                              <1> ;Now fetch the drive we are working on
    24 00000030 418A505C            <1>     mov dl, byte [r8 + psp.fcb1] ;Get the fcb 1 based drvNum
    25 00000034 FECA                <1>     dec dl  ;Turn it into a 0 based number
    26 00000036 88153D050000        <1>     mov byte [sysDrive], dl
    27 0000003C 80C241              <1>     add dl, "A"
    28 0000003F 8815CF050000        <1>     mov byte [rootDir], dl
    29 00000045 88156E050000        <1>     mov byte [biosDest], dl
    30 0000004B 881585050000        <1>     mov byte [dosDest], dl
    31 00000051 88159C050000        <1>     mov byte [cmdDest], dl
    32                              <1>     ;Now get current drive
    33 00000057 B800190000          <1>     mov eax, 1900h  ;Get current drive as the source of the copy
    34 0000005C CD21                <1>     int 21h
    35 0000005E 0441                <1>     add al, "A" ;Convert to an ASCII char
    36 00000060 880544050000        <1>     mov byte [biosFile], al
    37 00000066 88055C050000        <1>     mov byte [dosFile], al
    38 0000006C 880572050000        <1>     mov byte [cmdFile], al
    39                              <1> ;Now we check that the drive specified is a physical device
    40 00000072 B452                <1>     mov ah, 52h
    41 00000074 CD21                <1>     int 21h ;Get in rbx a ptr to list of lists
    42 00000076 4881C32A000000      <1>     add rbx, 2Ah    ;Point rbx to cdsHeadPtr
    43 0000007D 488B33              <1>     mov rsi, qword [rbx]    ;Get the ptr to the CDS array
    44 00000080 0FB60DF2040000      <1>     movzx ecx, byte [sysDrive]
    45 00000087 67E30B              <1>     jecxz .atCurrentCDS
    46                              <1> .walkCDSArray:
    47 0000008A 4881C65F000000      <1>     add rsi, cds_size
    48 00000091 FFC9                <1>     dec ecx
    49 00000093 75F5                <1>     jnz .walkCDSArray
    50                              <1> .atCurrentCDS: 
    51 00000095 66F7464300B0        <1>     test word [rsi + cds.wFlags], cdsJoinDrive | cdsSubstDrive | cdsRedirDrive
    52 0000009B 7587                <1>     jnz .badDrive
    53 0000009D 488B7645            <1>     mov rsi, qword [rsi + cds.qDPBPtr]  ;Get the DPB ptr 
    54 000000A1 488935E2040000      <1>     mov qword [dpbPtr], rsi ;Save the DPB ptr
    55                              <1> ;Now step 1, search root dir, if a file is found
    56 000000A8 488D1565050000      <1>     lea rdx, rootDir
    57 000000AF B916000000          <1>     mov ecx, dirInclusive
    58 000000B4 B8004E0000          <1>     mov eax, 4E00h
    59 000000B9 CD21                <1>     int 21h
    60 000000BB 7312                <1>     jnc .fileFound
    61 000000BD 2402                <1>     and al, 2   ;Clear the upper bit (turning errNoFil into errFnf)
    62 000000BF 3C02                <1>     cmp al, errFnf
    63 000000C1 7426                <1>     je .rootDirOk
    64                              <1> .badRoot:
    65 000000C3 488D1581050000      <1>     lea rdx, badRootDir
    66 000000CA E9A1020000          <1>     jmp badPrint
    67                              <1> .fileFound:
    68                              <1> ;A File was found, if it is a Volume Label, do a find next
    69 000000CF 498DB880000000      <1>     lea rdi, qword [r8 + psp.dta]   ;Get ptr to the find first block
    70 000000D6 807F0C08            <1>     cmp byte [rdi + ffBlock.attrib], dirVolumeID
    71 000000DA 75E7                <1>     jne .badRoot
    72 000000DC B8004F0000          <1>     mov eax, 4F00h  ;Find Next
    73 000000E1 CD21                <1>     int 21h
    74 000000E3 73DE                <1>     jnc .badRoot    ;Another file found, exit bad
    75 000000E5 3C12                <1>     cmp al, errNoFil
    76 000000E7 75DA                <1>     jne .badRoot
    77                              <1> .rootDirOk:
    78 000000E9 F8                  <1>     clc ;Clear CF
    79 000000EA B8001C0000          <1>     mov eax, 1C00h  ;Get FAT information
    80 000000EF 8A1584040000        <1>     mov dl, byte [sysDrive]
    81 000000F5 FEC2                <1>     inc dl  ;Convert to 1 based number
    82 000000F7 CD21                <1>     int 21h
    83 000000F9 66890D83040000      <1>     mov word [sectorSize], cx   ;Move the sector size in, use for buffer size
    84 00000100 88057F040000        <1>     mov byte [secPerClus], al   ;Save the number of sectors per cluster too
    85 00000106 89157A040000        <1>     mov dword [clustCnt], edx   ;Save the count of clusters
    86 0000010C 488D15F9050000      <1>     lea rdx, badSecSize
    87 00000113 663B0DE9FEFFFF      <1>     cmp cx, word [startSys.sectorSize]    ;Temporary restriction for DOS 1.0.
    88 0000011A 0F8550020000        <1>     jne badPrint
    89                              <1> ;Now open two handles to the two files
    90 00000120 E832040000          <1>     call dosCrit1Enter
    91                              <1> 
    92 00000125 488D357E040000      <1>     lea rsi, biosNamePair
    93 0000012C 488D3D6B040000      <1>     lea rdi, biosPair
    94 00000133 B90F000000          <1>     mov ecx, biosNameL
    95 00000138 B307                <1>     mov bl, dirReadOnly | dirHidden | dirSystem    ;Attribute
    96 0000013A E8D3020000          <1>     call openFiles
    97 0000013F 0F8217020000        <1>     jc badHandle
    98                              <1> 
    99 00000145 488D357C040000      <1>     lea rsi, dosNamePair
   100 0000014C 488D3D4F040000      <1>     lea rdi, dosPair
   101 00000153 B90E000000          <1>     mov ecx, dosNameL
   102 00000158 B307                <1>     mov bl, dirReadOnly | dirHidden | dirSystem    ;Attribute
   103 0000015A E8B3020000          <1>     call openFiles
   104 0000015F 0F82F7010000        <1>     jc badHandle
   105                              <1> 
   106 00000165 488D3532040000      <1>     lea rsi, biosPair
   107 0000016C E8C9020000          <1>     call copyFile
   108 00000171 0F82CB010000        <1>     jc badXfer
   109                              <1> 
   110 00000177 488D3524040000      <1>     lea rsi, dosPair
   111 0000017E E8B7020000          <1>     call copyFile
   112 00000183 0F82B9010000        <1>     jc badXfer
   113                              <1> 
   114                              <1> ;We close system handles here to update the DIR entries
   115 00000189 B8003E0000          <1>     mov eax, 3E00h
   116 0000018E 668B1D0B040000      <1>     mov bx, word [biosHdlDst]
   117 00000195 CD21                <1>     int 21h
   118 00000197 B8003E0000          <1>     mov eax, 3E00h
   119 0000019C 668B1D01040000      <1>     mov bx, word [dosHdlDst]
   120 000001A3 CD21                <1>     int 21h
   121                              <1> 
   122                              <1> ;Now also copy the default DOS command interpreter
   123 000001A5 488D3538040000      <1>     lea rsi, cmdNamePair
   124 000001AC 488D3DF3030000      <1>     lea rdi, cmdPair
   125 000001B3 B90F000000          <1>     mov ecx, cmdNameL
   126 000001B8 31DB                <1>     xor ebx, ebx    ;Attribute, no attribute
   127 000001BA E853020000          <1>     call openFiles
   128 000001BF 0F8297010000        <1>     jc badHandle
   129                              <1> 
   130 000001C5 488D35DA030000      <1>     lea rsi, cmdPair
   131 000001CC E869020000          <1>     call copyFile
   132 000001D1 0F826B010000        <1>     jc badXfer
   133                              <1> 
   134                              <1> ;Now we must do the fun part, setting the Boot Sector details
   135                              <1> ;Start by searching sysDrive for new files. 
   136                              <1> ;FOR SCPBIOS.SYS, need the start sector of the file and the number of sectors
   137                              <1> ; it is.
   138                              <1> ;FOR SCPDOS.SYS, need only the start sector of the file.
   139                              <1> 
   140                              <1> ;We do this by:
   141                              <1> ; - Reading the DPB, getting the first sector of the Root Directory
   142                              <1> ; - Read the necessary data from the Root Directory Copy
   143                              <1> ; - Read the BPB again
   144                              <1> ; - Set the variables in the BPB.
   145                              <1> ; - Set the bootable flag in the BPB
   146                              <1> ; - Write it back out to disk.
   147                              <1> ;
   148                              <1> ;3 Direct IO's needed. 
   149                              <1> ;   1) Read Sector 1 of Root Dir
   150                              <1> ;   2) Read BPB
   151                              <1> ;   3) Write back BPB 
   152 000001D7 488B2DAC030000      <1>     mov rbp, qword [dpbPtr]
   153                              <1> ;Start by saving the free cluster count as DOS will force an
   154                              <1> ; unnecessary recount due to Direct IO which is annoying on large disks.
   155 000001DE 8B4531              <1>     mov eax, dword [rbp + dpb.dFreeClustCnt]
   156 000001E1 8905B3030000        <1>     mov dword [dFreeClustCnt], eax
   157                              <1> ;Now start procedure.
   158 000001E7 31C0                <1>     xor eax, eax    ;Request first sector of root directory
   159 000001E9 E8CE020000          <1>     call getStartSectorOfCluster    ;Thanks DOS!!
   160 000001EE 4889059D030000      <1>     mov qword [xfrSector], rax
   161                              <1>     ;rax has the first sector of the root directory, read it in
   162 000001F5 E8EF020000          <1>     call readWrapper
   163 000001FA 0F8270010000        <1>     jc badPrint
   164                              <1>     ;First entry could be volume id so double check
   165 00000200 488B3573030000      <1>     mov rsi, qword [memoryBlock]
   166 00000207 F6460B08            <1>     test byte [rsi + fatDirEntry.attribute], dirVolumeID
   167 0000020B 7407                <1>     jz .notVolID
   168 0000020D 4881C620000000      <1>     add rsi, fatDirEntry_size   ;Goto next entry. This must be it
   169                              <1> .notVolID:
   170 00000214 0FB75614            <1>     movzx edx, word [rsi + fatDirEntry.fstClusHi]   ;Get hi bits of cluster num
