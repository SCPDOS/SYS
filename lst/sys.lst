   377 000004A6 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
   378 000004AC 730C                <1>     jae .exit
   379 000004AE FFC9                <1>     dec ecx     ;FAT 16 marker
   380 000004B0 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
   381 000004B6 7302                <1>     jae .exit
   382 000004B8 FFC9                <1>     dec ecx     ;FAT 12 marker
   383                              <1> .exit:
   384 000004BA 5B                  <1>     pop rbx
   385                              <1>     return
