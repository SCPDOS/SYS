   387                              <1> getStartSectorOfCluster:
   388                              <1> ;Input: eax = Cluster Number
   389                              <1> ;       rbp = dpb pointer
   390                              <1> ;Output: rax = Starting Sector number for cluster
   391                              <1> ;Gives the data sector we are at in the current cluster
   392                              <1> ;Start Sector = (ClusterNumber - 2)*SecPerClust + DataAreaStartSector
   393 000004BC 51                  <1>     push rcx
   394 000004BD 09C0                <1>     or eax, eax ;Zero upper dword
   395 000004BF 7416                <1>     jz .rootDir ;If eax is zero, that is an alias for Root Directory
   396                              <1> .fat32Root:
   397 000004C1 482D02000000        <1>     sub rax, 2
   398 000004C7 8A4D05              <1>     mov cl, byte [rbp + dpb.bSecPerClustShift]
   399 000004CA 48D3E0              <1>     shl rax, cl
   400 000004CD 31C9                <1>     xor ecx, ecx
   401 000004CF 8B4D0B              <1>     mov ecx, dword [rbp + dpb.dClusterHeapOffset]
   402 000004D2 4801C8              <1>     add rax, rcx
   403                              <1>     ;rax now has the first sector of the current cluster
   404 000004D5 59                  <1>     pop rcx
   405                              <1>     return
    13                              <2> %%_ret:
    14 000004D6 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   406                              <1> .rootDir:
   407 000004D7 8B4517              <1>     mov eax, dword [rbp + dpb.dFirstUnitOfRootDir]
   408 000004DA E8BEFFFFFF          <1>     call getFATtype
   409 000004DF 81F902000000        <1>     cmp ecx, 2
   410 000004E5 74DA                <1>     je .fat32Root   ;If FAT32, eax now has zero extended 1st cluster of Root Dir
   411                              <1>     ;Else rax has the first sector of the Root Dir
   412 000004E7 59                  <1>     pop rcx
   413                              <1>     return
    13                              <2> %%_ret:
    14 000004E8 C3                  <2>  ret
