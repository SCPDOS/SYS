   370                              <1> getFATtype:
   371                              <1> ;Gets a pointer to a DPB and returns the FAT type on the drive
   372                              <1> ;Entry: rbp = DPB to ascertain FAT
   373                              <1> ;Exit: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
   374 0000049D 53                  <1>     push rbx
   375 0000049E 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
